{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": { "api/foco/*.mjs": { "includeFiles": "foco/compra/versiones/**", "maxDuration": 60 } },
  "redirects": [
    {"source":"/:path*", "has":[{"type":"host","value":"www.getfoco.co"}], "destination":"https://getfoco.co/:path*", "permanent":true},
    {"source":"/foco", "destination":"/", "permanent":true},
    {"source":"/foco/privacidad/:path*", "destination":"/privacidad/:path*", "permanent":true},
    {"source":"/foco/terminos/:path*", "destination":"/terminos/:path*", "permanent":true},
    {"source":"/foco/soporte/:path*", "destination":"/soporte/:path*", "permanent":true},
    {"source":"/foco/pago/:path*", "destination":"/pago/:path*", "permanent":true},
    {"source":"/foco/compra/:path*", "destination":"/compra/:path*", "permanent":true}
  ],
  "headers":[
    {"source":"/api/:path*","headers":[{"key":"Cache-Control","value":"no-store"},{"key":"X-Content-Type-Options","value":"nosniff"}]},
    {"source":"/:path*","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}
  ]
}
