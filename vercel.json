{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "functions": {
    "api/foco/faq.mjs": {
      "includeFiles": "server/foco/faq-knowledge.json",
      "maxDuration": 30
    },
    "api/foco/*.mjs": {
      "includeFiles": "foco/compra/versiones/**",
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.getfoco.co"
        }
      ],
      "destination": "https://getfoco.co/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/foco/compra/privacidad/index.html",
      "destination": "/compra/privacidad/",
      "permanent": true
    },
    {
      "source": "/compra/privacidad/index.html",
      "destination": "/compra/privacidad/",
      "permanent": true
    },
    {
      "source": "/foco/compra/index.html",
      "destination": "/compra/",
      "permanent": true
    },
    {
      "source": "/compra/index.html",
      "destination": "/compra/",
      "permanent": true
    },
    {
      "source": "/foco/terminos/index.html",
      "destination": "/terminos/",
      "permanent": true
    },
    {
      "source": "/terminos/index.html",
      "destination": "/terminos/",
      "permanent": true
    },
    {
      "source": "/foco/privacidad/index.html",
      "destination": "/privacidad/",
      "permanent": true
    },
    {
      "source": "/privacidad/index.html",
      "destination": "/privacidad/",
      "permanent": true
    },
    {
      "source": "/foco/soporte/index.html",
      "destination": "/soporte/",
      "permanent": true
    },
    {
      "source": "/soporte/index.html",
      "destination": "/soporte/",
      "permanent": true
    },
    {
      "source": "/foco/pago/index.html",
      "destination": "/pago/",
      "permanent": true
    },
    {
      "source": "/pago/index.html",
      "destination": "/pago/",
      "permanent": true
    },
    {
      "source": "/foco/comprar/index.html",
      "destination": "/comprar/",
      "permanent": true
    },
    {
      "source": "/comprar/index.html",
      "destination": "/comprar/",
      "permanent": true
    },
    {
      "source": "/foco/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/foco",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/foco/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/foco/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/foco/privacidad/:path*",
      "destination": "/privacidad/:path*",
      "permanent": true
    },
    {
      "source": "/foco/terminos/:path*",
      "destination": "/terminos/:path*",
      "permanent": true
    },
    {
      "source": "/foco/soporte/:path*",
      "destination": "/soporte/:path*",
      "permanent": true
    },
    {
      "source": "/foco/pago/:path*",
      "destination": "/pago/:path*",
      "permanent": true
    },
    {
      "source": "/foco/compra/:path*",
      "destination": "/compra/:path*",
      "permanent": true
    },
    {
      "source": "/foco/privacidad/:path*/",
      "destination": "/privacidad/:path*/",
      "permanent": true
    },
    {
      "source": "/foco/terminos/:path*/",
      "destination": "/terminos/:path*/",
      "permanent": true
    },
    {
      "source": "/foco/soporte/:path*/",
      "destination": "/soporte/:path*/",
      "permanent": true
    },
    {
      "source": "/foco/pago/:path*/",
      "destination": "/pago/:path*/",
      "permanent": true
    },
    {
      "source": "/foco/compra/:path*/",
      "destination": "/compra/:path*/",
      "permanent": true
    },
    {
      "source": "/foco/comprar",
      "destination": "/comprar/",
      "permanent": true
    },
    {
      "source": "/foco/comprar/",
      "destination": "/comprar/",
      "permanent": true
    },
    {
      "source": "/foco/blog",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/foco/blog/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/foco/blog/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/foco/_assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/foco/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/compra/versiones/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/foco/compra/versiones/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
