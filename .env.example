# Production values belong only in Vercel getfoco Production (never browser code).
# Preview/development MUST use test credentials and a separate private Blob store.
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=
FOCO_CHECKOUT_ENABLED=false
FOCO_EMAIL_ENABLED=false
# Sandbox restricts receipts to this authorized recipient.
FOCO_TEST_EMAIL_TO=
# VERCEL_ENV and VERCEL_URL are trusted system variables, not manual config.
# Legacy Netlify sandbox only:
FOCO_SANDBOX_ORIGIN=
