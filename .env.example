# Netlify Functions scope only. Never prefix secrets with PUBLIC or add them to JS.
# Deploy previews/local development MUST use test mode and sandbox credentials.
WOMPI_ENVIRONMENT=test
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
RESEND_API_KEY=
FOCO_CHECKOUT_ENABLED=false
FOCO_EMAIL_ENABLED=false
# Production automatically supplies CONTEXT=production in Netlify.
# No storage credentials required in hosted functions: Netlify Blobs auto-authenticates.
